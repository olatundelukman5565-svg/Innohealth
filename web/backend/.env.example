# Copy to .env and adjust. Never commit a real .env file.

# SQLAlchemy connection string. SQLite requires zero setup for local dev;
# point this at Postgres for production, e.g.:
#   postgresql+psycopg2://thermalmesh:password@localhost:5432/thermalmesh
DATABASE_URL=sqlite:///./thermalmesh.db

# HMAC signing secret for JWT access tokens. Generate a real random value
# for anything beyond local development, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Local filesystem root for uploaded files and processing outputs. The
# storage layer is written as an abstraction so this can later point at an
# S3-compatible bucket without changing calling code.
STORAGE_PATH=./storage

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Maximum upload size per file, in megabytes.
MAX_UPLOAD_MB=512
